# Copy this file to .env and adjust the values.

# Where the data comes from:
#   fixture = saved sample responses in data/fixtures (works offline, default)
#   live    = call https://api.fda.gov for real
OPENFDA_MODE=fixture

# Optional. A free key raises openFDA's rate limits: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_SECONDS=10
